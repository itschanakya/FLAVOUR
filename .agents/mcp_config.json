{
  "mcpServers": {
    "cloudinary-asset-mgmt": {
      "command": "npx",
      "args": [
        "-y",
        "--registry",
        "https://registry.npmjs.org",
        "--package",
        "@cloudinary/asset-management",
        "--",
        "mcp",
        "start",
        "--transport",
        "stdio"
      ],
      "envFile": "${workspaceFolder}/backend/.env"
    },
    "cloudinary-env-config": {
      "command": "npx",
      "args": [
        "-y",
        "--registry",
        "https://registry.npmjs.org",
        "--package",
        "@cloudinary/environment-config",
        "--",
        "mcp",
        "start",
        "--transport",
        "stdio"
      ],
      "envFile": "${workspaceFolder}/backend/.env"
    }
  }
}
